generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum PapelCondominio {
  ADMINISTRADOR
  SINDICO
  SUBSINDICO
  CONSELHEIRO
  FINANCEIRO
  PORTEIRO
  MORADOR
}

enum TipoUnidade {
  APARTAMENTO
  CASA
  SALA
  LOJA
  OUTRA
}

enum PapelMoradorUnidade {
  PROPRIETARIO
  INQUILINO
  MORADOR
  DEPENDENTE
  OUTRO
}

enum TipoDocumentoVisitante {
  CPF
  RG
  CNH
  PASSAPORTE
  OUTRO
}

enum StatusAutorizacaoVisitante {
  ATIVA
  CANCELADA
  ENCERRADA
}

enum StatusOcorrencia {
  ABERTA
  EM_ANALISE
  EM_ANDAMENTO
  AGUARDANDO_MORADOR
  RESOLVIDA
  CANCELADA
}

enum PrioridadeOcorrencia {
  BAIXA
  MEDIA
  ALTA
  URGENTE
}

enum StatusComunicado {
  RASCUNHO
  PUBLICADO
  ARQUIVADO
}

enum PrioridadeComunicado {
  NORMAL
  IMPORTANTE
  URGENTE
}

enum StatusDocumentoCondominio {
  RASCUNHO
  PUBLICADO
  ARQUIVADO
}

enum StatusReservaAreaComum {
  SOLICITADA
  APROVADA
  RECUSADA
  CANCELADA
  CONCLUIDA
}

enum TipoCategoriaFinanceira {
  RECEITA
  DESPESA
  AMBOS
}

enum TipoLancamentoFinanceiro {
  RECEITA
  DESPESA
}

enum StatusLancamentoFinanceiro {
  PENDENTE
  PAGO
  CANCELADO
}

enum StatusCobrancaCondominial {
  PENDENTE
  PAGO
  CANCELADA
}

enum TipoVagaGaragem {
  PRIVATIVA
  ROTATIVA
  VISITANTE
  SERVICO
  OUTRA
}

enum TipoVeiculo {
  CARRO
  MOTO
  CAMINHONETE
  VAN
  BICICLETA
  OUTRO
}

enum TipoEncomendaPortaria {
  ENCOMENDA
  CORRESPONDENCIA
  DOCUMENTO
  NOTIFICACAO
  OUTRO
}

enum StatusEncomendaPortaria {
  RECEBIDA
  RETIRADA
  DEVOLVIDA
}

enum StatusAutorizacaoPrestador {
  ATIVA
  CANCELADA
  ENCERRADA
}

enum StatusOrdemServico {
  ABERTA
  AGENDADA
  EM_EXECUCAO
  CONCLUIDA
  CANCELADA
}

enum StatusContratoCondominio {
  ATIVO
  ENCERRADO
  CANCELADO
}

enum PrioridadeOrdemServico {
  BAIXA
  MEDIA
  ALTA
  URGENTE
}

enum StatusAssembleia {
  RASCUNHO
  CONVOCADA
  EM_ANDAMENTO
  ENCERRADA
  CANCELADA
}

enum ModalidadeAssembleia {
  PRESENCIAL
  ONLINE
  HIBRIDA
}

enum StatusPautaAssembleia {
  ABERTA
  DELIBERADA
  CANCELADA
}

enum StatusVotacaoAssembleia {
  RASCUNHO
  ABERTA
  ENCERRADA
  CANCELADA
}

model Condominio {
  id       Int     @id @default(autoincrement())
  nome     String  @db.VarChar(180)
  slug     String  @unique @db.VarChar(180)
  cnpj     String? @unique @db.VarChar(20)
  email    String? @db.VarChar(180)
  telefone String? @db.VarChar(30)

  pixChave                String? @db.VarChar(180)
  pixTipo                 String? @db.VarChar(30)
  beneficiarioPagamento   String? @db.VarChar(180)
  bancoPagamento          String? @db.VarChar(180)
  instrucoesPagamento     String? @db.Text
  mensagemCobrancaPadrao  String? @db.Text

  nomeExibicaoPortal       String? @db.VarChar(180)
  logoUrl                  String? @db.VarChar(255)
  mensagemBoasVindasPortal String? @db.Text
  instrucoesGeraisPortal   String? @db.Text
  contatosUteisPortal      String? @db.Text
  prazoPadraoCobrancaDias  Int?
  instrucoesVisitantes     String? @db.Text
  instrucoesEncomendas     String? @db.Text
  politicaReservas         String? @db.Text
  assinaturaComunicados    String? @db.Text

  cep         String? @db.VarChar(12)
  logradouro  String? @db.VarChar(180)
  numero      String? @db.VarChar(30)
  complemento String? @db.VarChar(120)
  bairro      String? @db.VarChar(120)
  cidade      String? @db.VarChar(120)
  uf          String? @db.Char(2)

  ativo Boolean @default(true)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  usuarios                 UsuarioCondominio[]
  blocos                   Bloco[]
  unidades                 Unidade[]
  moradores                Morador[]
  visitantes               Visitante[]
  autorizacoesVisitante    AutorizacaoVisitante[]
  registrosAcesso          RegistroAcessoVisitante[]
  ocorrencias              Ocorrencia[]
  comunicados              Comunicado[]
  documentosCondominio     DocumentoCondominio[]
  areasComuns              AreaComum[]
  reservasAreasComuns      ReservaAreaComum[]
  categoriasFinanceiras    CategoriaFinanceira[]
  lancamentosFinanceiros   LancamentoFinanceiro[]
  cobrancasCondominiais    CobrancaCondominial[]
  vagasGaragem             VagaGaragem[]
  veiculos                 Veiculo[]
  encomendasPortaria       EncomendaPortaria[]
  prestadoresServico       PrestadorServico[]
  autorizacoesPrestador    AutorizacaoPrestador[]
  registrosAcessoPrestador RegistroAcessoPrestador[]
  ordensServico            OrdemServico[]
  contratosCondominio       ContratoCondominio[]
  assembleias              Assembleia[]
  votacoesAssembleia       VotacaoAssembleia[]

  presencasAssembleia PresencaAssembleia[]

    historicosFinanceiros HistoricoFinanceiro[] @relation("HistoricosFinanceirosCondominio")
@@map("condominios")
}

model Usuario {
  id        Int     @id @default(autoincrement())
  nome      String  @db.VarChar(180)
  email     String  @unique @db.VarChar(180)
  telefone  String? @db.VarChar(30)
  senhaHash String? @db.VarChar(255)
  avatarUrl String? @db.VarChar(255)

  superAdmin    Boolean   @default(false)
  ativo         Boolean   @default(true)
  ultimoLoginEm DateTime?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  condominios                      UsuarioCondominio[]
  autorizacoesVisitante            AutorizacaoVisitante[]        @relation("AutorizacoesVisitanteCriadas")
  registrosEntradaVisitante        RegistroAcessoVisitante[]     @relation("RegistrosEntradaPorUsuario")
  registrosSaidaVisitante          RegistroAcessoVisitante[]     @relation("RegistrosSaidaPorUsuario")
  ocorrenciasCriadas               Ocorrencia[]                  @relation("OcorrenciasCriadas")
  ocorrenciasHistorico             OcorrenciaHistoricoStatus[]   @relation("OcorrenciasHistoricoUsuario")
  comunicadosCriados               Comunicado[]                  @relation("ComunicadosCriados")
  documentosCondominioCriados      DocumentoCondominio[]         @relation("DocumentosCondominioCriados")
  reservasCriadas                  ReservaAreaComum[]            @relation("ReservasAreasComunsCriadas")
  reservasAprovadas                ReservaAreaComum[]            @relation("ReservasAreasComunsAprovadas")
  lancamentosFinanceirosCriados    LancamentoFinanceiro[]        @relation("LancamentosFinanceirosCriados")
  lancamentosFinanceirosPagos      LancamentoFinanceiro[]        @relation("LancamentosFinanceirosPagos")
  lancamentosFinanceirosCancelados LancamentoFinanceiro[]        @relation("LancamentosFinanceirosCancelados")
  cobrancasCriadas                 CobrancaCondominial[]         @relation("CobrancasCriadas")
  cobrancasPagas                   CobrancaCondominial[]         @relation("CobrancasPagas")
  cobrancasCanceladas              CobrancaCondominial[]         @relation("CobrancasCanceladas")
  encomendasRecebidas              EncomendaPortaria[]           @relation("EncomendasRecebidas")
  encomendasRetiradas              EncomendaPortaria[]           @relation("EncomendasRetiradas")
  encomendasDevolvidas             EncomendaPortaria[]           @relation("EncomendasDevolvidas")
  autorizacoesPrestadorCriadas     AutorizacaoPrestador[]        @relation("AutorizacoesPrestadorCriadas")
  registrosEntradaPrestador        RegistroAcessoPrestador[]     @relation("RegistrosEntradaPrestador")
  registrosSaidaPrestador          RegistroAcessoPrestador[]     @relation("RegistrosSaidaPrestador")
  ordensServicoCriadas             OrdemServico[]                @relation("OrdensServicoCriadas")
  ordensServicoHistorico           OrdemServicoHistoricoStatus[] @relation("OrdensServicoHistoricoUsuario")
  contratosCondominioCriados       ContratoCondominio[]          @relation("ContratosCondominioCriados")
  assembleiasCriadas               Assembleia[]                  @relation("AssembleiasCriadas")
  pautasAssembleiaCriadas          PautaAssembleia[]             @relation("PautasAssembleiaCriadas")
  votacoesAssembleiaCriadas        VotacaoAssembleia[]           @relation("VotacoesAssembleiaCriadas")
  votosAssembleiaRegistrados       VotoAssembleia[]              @relation("VotosAssembleiaRegistrados")
  moradoresVinculados              Morador[]                     @relation("MoradorUsuario")

  presencasAssembleiaRegistradas PresencaAssembleia[] @relation("PresencasAssembleiaRegistradas")

    historicosFinanceiros HistoricoFinanceiro[] @relation("HistoricosFinanceirosUsuario")
@@map("usuarios")
}

model UsuarioCondominio {
  id Int @id @default(autoincrement())

  usuarioId    Int
  condominioId Int

  papel     PapelCondominio
  principal Boolean         @default(false)
  ativo     Boolean         @default(true)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  usuario    Usuario    @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  condominio Condominio @relation(fields: [condominioId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, condominioId])
  @@index([condominioId])
  @@index([usuarioId])
  @@map("usuarios_condominios")
}

model Bloco {
  id           Int     @id @default(autoincrement())
  condominioId Int
  nome         String  @db.VarChar(120)
  descricao    String? @db.VarChar(255)
  ordem        Int     @default(0)
  ativo        Boolean @default(true)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  condominio Condominio @relation(fields: [condominioId], references: [id], onDelete: Cascade)
  unidades   Unidade[]

  @@unique([condominioId, nome])
  @@index([condominioId])
  @@map("blocos")
}

model Unidade {
  id           Int  @id @default(autoincrement())
  condominioId Int
  blocoId      Int?

  numero        String      @db.VarChar(40)
  identificador String      @db.VarChar(180)
  tipo          TipoUnidade @default(APARTAMENTO)
  andar         Int?
  observacoes   String?     @db.VarChar(255)
  ativo         Boolean     @default(true)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  condominio               Condominio                @relation(fields: [condominioId], references: [id], onDelete: Cascade)
  bloco                    Bloco?                    @relation(fields: [blocoId], references: [id], onDelete: SetNull)
  moradores                MoradorUnidade[]
  autorizacoesVisitante    AutorizacaoVisitante[]
  registrosAcessoVisitante RegistroAcessoVisitante[]
  ocorrencias              Ocorrencia[]
  reservasAreasComuns      ReservaAreaComum[]
  cobrancasCondominiais    CobrancaCondominial[]
  vagasGaragem             VagaGaragem[]
  veiculos                 Veiculo[]
  encomendasPortaria       EncomendaPortaria[]
  autorizacoesPrestador    AutorizacaoPrestador[]
  registrosAcessoPrestador RegistroAcessoPrestador[]
  ordensServico            OrdemServico[]
  votosAssembleia          VotoAssembleia[]

  presencasAssembleia PresencaAssembleia[]

  @@unique([condominioId, identificador])
  @@index([condominioId])
  @@index([blocoId])
  @@map("unidades")
}

model Morador {
  id           Int  @id @default(autoincrement())
  condominioId Int
  usuarioId    Int?

  nome     String  @db.VarChar(180)
  email    String? @db.VarChar(180)
  telefone String? @db.VarChar(30)
  ativo    Boolean @default(true)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  condominio Condominio @relation(fields: [condominioId], references: [id], onDelete: Cascade)

  usuario               Usuario?               @relation("MoradorUsuario", fields: [usuarioId], references: [id], onDelete: SetNull)
  unidades              MoradorUnidade[]
  autorizacoesVisitante AutorizacaoVisitante[]
  ocorrencias           Ocorrencia[]
  reservasAreasComuns   ReservaAreaComum[]
  cobrancasCondominiais CobrancaCondominial[]
  veiculos              Veiculo[]
  encomendasPortaria    EncomendaPortaria[]
  autorizacoesPrestador AutorizacaoPrestador[]
  votosAssembleia       VotoAssembleia[]

  presencasAssembleia PresencaAssembleia[]

  @@unique([condominioId, usuarioId])
  @@index([condominioId])
  @@map("moradores")
}

model MoradorUnidade {
  id        Int @id @default(autoincrement())
  moradorId Int
  unidadeId Int

  papel     PapelMoradorUnidade @default(MORADOR)
  principal Boolean             @default(false)
  inicioEm  DateTime            @default(now())
  fimEm     DateTime?
  ativo     Boolean             @default(true)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  morador Morador @relation(fields: [moradorId], references: [id], onDelete: Cascade)
  unidade Unidade @relation(fields: [unidadeId], references: [id], onDelete: Cascade)

  @@unique([moradorId, unidadeId])
  @@index([moradorId])
  @@index([unidadeId])
  @@map("moradores_unidades")
}

model Visitante {
  id           Int @id @default(autoincrement())
  condominioId Int

  nome          String                  @db.VarChar(180)
  tipoDocumento TipoDocumentoVisitante?
  documento     String?                 @db.VarChar(60)
  telefone      String?                 @db.VarChar(30)
  observacoes   String?                 @db.VarChar(255)
  ativo         Boolean                 @default(true)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  condominio      Condominio                @relation(fields: [condominioId], references: [id], onDelete: Cascade)
  autorizacoes    AutorizacaoVisitante[]
  registrosAcesso RegistroAcessoVisitante[]

  @@unique([condominioId, documento])
  @@index([condominioId])
  @@map("visitantes")
}

model AutorizacaoVisitante {
  id                 Int  @id @default(autoincrement())
  condominioId       Int
  visitanteId        Int
  unidadeId          Int
  moradorId          Int?
  criadoPorUsuarioId Int?

  status      StatusAutorizacaoVisitante @default(ATIVA)
  inicioEm    DateTime
  fimEm       DateTime
  observacoes String?                    @db.VarChar(255)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  condominio       Condominio                @relation(fields: [condominioId], references: [id], onDelete: Cascade)
  visitante        Visitante                 @relation(fields: [visitanteId], references: [id], onDelete: Cascade)
  unidade          Unidade                   @relation(fields: [unidadeId], references: [id], onDelete: Cascade)
  morador          Morador?                  @relation(fields: [moradorId], references: [id], onDelete: SetNull)
  criadoPorUsuario Usuario?                  @relation("AutorizacoesVisitanteCriadas", fields: [criadoPorUsuarioId], references: [id], onDelete: SetNull)
  registrosAcesso  RegistroAcessoVisitante[]

  @@index([condominioId])
  @@index([visitanteId])
  @@index([unidadeId])
  @@index([moradorId])
  @@index([criadoPorUsuarioId])
  @@map("autorizacoes_visitantes")
}

model RegistroAcessoVisitante {
  id                     Int @id @default(autoincrement())
  condominioId           Int
  autorizacaoVisitanteId Int
  visitanteId            Int
  unidadeId              Int

  entradaEm          DateTime  @default(now())
  saidaEm            DateTime?
  observacoesEntrada String?   @db.VarChar(255)
  observacoesSaida   String?   @db.VarChar(255)

  entradaRegistradaPorId Int?
  saidaRegistradaPorId   Int?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  condominio           Condominio           @relation(fields: [condominioId], references: [id], onDelete: Cascade)
  autorizacaoVisitante AutorizacaoVisitante @relation(fields: [autorizacaoVisitanteId], references: [id], onDelete: Cascade)
  visitante            Visitante            @relation(fields: [visitanteId], references: [id], onDelete: Cascade)
  unidade              Unidade              @relation(fields: [unidadeId], references: [id], onDelete: Cascade)
  entradaRegistradaPor Usuario?             @relation("RegistrosEntradaPorUsuario", fields: [entradaRegistradaPorId], references: [id], onDelete: SetNull)
  saidaRegistradaPor   Usuario?             @relation("RegistrosSaidaPorUsuario", fields: [saidaRegistradaPorId], references: [id], onDelete: SetNull)

  @@index([condominioId])
  @@index([autorizacaoVisitanteId])
  @@index([visitanteId])
  @@index([unidadeId])
  @@index([entradaRegistradaPorId])
  @@index([saidaRegistradaPorId])
  @@map("registros_acesso_visitantes")
}

model Ocorrencia {
  id                 Int  @id @default(autoincrement())
  condominioId       Int
  unidadeId          Int?
  moradorId          Int?
  criadoPorUsuarioId Int?

  titulo      String               @db.VarChar(180)
  descricao   String               @db.Text
  categoria   String?              @db.VarChar(120)
  prioridade  PrioridadeOcorrencia @default(MEDIA)
  status      StatusOcorrencia     @default(ABERTA)
  encerradaEm DateTime?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  condominio       Condominio                  @relation(fields: [condominioId], references: [id], onDelete: Cascade)
  unidade          Unidade?                    @relation(fields: [unidadeId], references: [id], onDelete: SetNull)
  morador          Morador?                    @relation(fields: [moradorId], references: [id], onDelete: SetNull)
  criadoPorUsuario Usuario?                    @relation("OcorrenciasCriadas", fields: [criadoPorUsuarioId], references: [id], onDelete: SetNull)
  historicoStatus  OcorrenciaHistoricoStatus[]
  ordensServico    OrdemServico[]

  @@index([condominioId])
  @@index([unidadeId])
  @@index([moradorId])
  @@index([criadoPorUsuarioId])
  @@index([status])
  @@index([prioridade])
  @@map("ocorrencias")
}

model OcorrenciaHistoricoStatus {
  id           Int  @id @default(autoincrement())
  ocorrenciaId Int
  usuarioId    Int?

  statusAnterior StatusOcorrencia?
  statusNovo     StatusOcorrencia
  observacao     String?           @db.VarChar(255)

  criadoEm DateTime @default(now())

  ocorrencia Ocorrencia @relation(fields: [ocorrenciaId], references: [id], onDelete: Cascade)
  usuario    Usuario?   @relation("OcorrenciasHistoricoUsuario", fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([ocorrenciaId])
  @@index([usuarioId])
  @@map("ocorrencias_historico_status")
}

model DocumentoCondominio {
  id                 Int  @id @default(autoincrement())
  condominioId       Int
  criadoPorUsuarioId Int?

  titulo           String                    @db.VarChar(180)
  categoria        String?                   @db.VarChar(120)
  descricao        String?                   @db.Text
  url              String                    @db.VarChar(500)
  publicoMoradores Boolean                   @default(true)
  destaque         Boolean                   @default(false)
  status           StatusDocumentoCondominio @default(RASCUNHO)

  publicadoEm DateTime?
  arquivadoEm DateTime?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  condominio       Condominio @relation(fields: [condominioId], references: [id], onDelete: Cascade)
  criadoPorUsuario Usuario?   @relation("DocumentosCondominioCriados", fields: [criadoPorUsuarioId], references: [id], onDelete: SetNull)

  @@index([condominioId])
  @@index([criadoPorUsuarioId])
  @@index([status])
  @@index([categoria])
  @@index([publicoMoradores])
  @@index([destaque])
  @@map("documentos_condominio")
}

model Comunicado {
  id                 Int  @id @default(autoincrement())
  condominioId       Int
  criadoPorUsuarioId Int?

  titulo     String               @db.VarChar(180)
  conteudo   String               @db.Text
  categoria  String?              @db.VarChar(120)
  prioridade PrioridadeComunicado @default(NORMAL)
  status     StatusComunicado     @default(RASCUNHO)
  destaque   Boolean              @default(false)

  publicadoEm DateTime?
  expiraEm    DateTime?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  condominio       Condominio @relation(fields: [condominioId], references: [id], onDelete: Cascade)
  criadoPorUsuario Usuario?   @relation("ComunicadosCriados", fields: [criadoPorUsuarioId], references: [id], onDelete: SetNull)

  @@index([condominioId])
  @@index([criadoPorUsuarioId])
  @@index([status])
  @@index([prioridade])
  @@map("comunicados")
}

model ComunicadoLeitura {
  id           Int      @id @default(autoincrement())
  condominioId Int
  comunicadoId Int
  usuarioId    Int
  moradorId    Int

  lidoEm      DateTime @default(now())
  criadoEm    DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@unique([comunicadoId, usuarioId, moradorId], map: "uq_comunicados_leituras")
  @@index([condominioId], map: "idx_comunicados_leituras_condominio")
  @@index([comunicadoId], map: "idx_comunicados_leituras_comunicado")
  @@index([usuarioId], map: "idx_comunicados_leituras_usuario")
  @@index([moradorId], map: "idx_comunicados_leituras_morador")
  @@map("comunicados_leituras")
}

model AreaComum {
  id           Int @id @default(autoincrement())
  condominioId Int

  nome           String  @db.VarChar(180)
  descricao      String? @db.VarChar(255)
  capacidade     Int?
  exigeAprovacao Boolean @default(true)
  permiteReserva Boolean @default(true)
  observacoes    String? @db.VarChar(255)
  ativo          Boolean @default(true)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  condominio Condominio         @relation(fields: [condominioId], references: [id], onDelete: Cascade)
  reservas   ReservaAreaComum[]

  @@unique([condominioId, nome])
  @@index([condominioId])
  @@map("areas_comuns")
}

model ReservaAreaComum {
  id                   Int  @id @default(autoincrement())
  condominioId         Int
  areaComumId          Int
  unidadeId            Int?
  moradorId            Int?
  criadoPorUsuarioId   Int?
  aprovadoPorUsuarioId Int?

  titulo       String?                @db.VarChar(180)
  inicioEm     DateTime
  fimEm        DateTime
  status       StatusReservaAreaComum @default(SOLICITADA)
  observacoes  String?                @db.VarChar(255)
  motivoRecusa String?                @db.VarChar(255)

  aprovadoEm  DateTime?
  recusadoEm  DateTime?
  canceladoEm DateTime?
  concluidoEm DateTime?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  condominio         Condominio @relation(fields: [condominioId], references: [id], onDelete: Cascade)
  areaComum          AreaComum  @relation(fields: [areaComumId], references: [id], onDelete: Cascade)
