  condominioId           Int
  assembleiaId           Int
  unidadeId              Int
  moradorId              Int?
  registradoPorUsuarioId Int?

  nomeRepresentante      String?  @db.VarChar(180)
  documentoRepresentante String?  @db.VarChar(60)
  porProcuracao          Boolean  @default(false)
  procuracaoObservacoes  String?  @db.VarChar(255)
  observacoes            String?  @db.VarChar(255)
  registradoEm           DateTime @default(now())

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  condominio           Condominio @relation(fields: [condominioId], references: [id], onDelete: Cascade)
  assembleia           Assembleia @relation(fields: [assembleiaId], references: [id], onDelete: Cascade)
  unidade              Unidade    @relation(fields: [unidadeId], references: [id], onDelete: Cascade)
  morador              Morador?   @relation(fields: [moradorId], references: [id], onDelete: SetNull)
  registradoPorUsuario Usuario?   @relation("PresencasAssembleiaRegistradas", fields: [registradoPorUsuarioId], references: [id], onDelete: SetNull)

  @@unique([assembleiaId, unidadeId])
  @@index([condominioId])
  @@index([assembleiaId])
  @@index([unidadeId])
  @@index([moradorId])
  @@index([registradoPorUsuarioId])
  @@index([registradoEm])
  @@map("presencas_assembleia")
}

model NotificacaoPreferenciaPortal {
  id           Int      @id @default(autoincrement())
  condominioId Int
  usuarioId    Int
  moradorId    Int
  tipo         String   @db.VarChar(40)
  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@unique([condominioId, usuarioId, moradorId, tipo], map: "uq_notificacoes_preferencias")
  @@index([condominioId], map: "idx_notificacoes_preferencias_condominio")
  @@index([usuarioId], map: "idx_notificacoes_preferencias_usuario")
  @@index([moradorId], map: "idx_notificacoes_preferencias_morador")
  @@map("notificacoes_preferencias")
}
